# AI Task Processing Platform - Docker Environment Example
# Copy this to .env and customize for your environment

# ===========================
# BACKEND CONFIGURATION
# ===========================
NODE_ENV=production
PORT=5000

# MongoDB Connection
# For Docker: use service name 'mongodb' as hostname
# For local: use localhost:27017
MONGO_URI=mongodb://mongodb:27017/ai_task_platform

# Redis Configuration
# For Docker: use service name 'redis' as hostname
# For local: use localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Configuration
# Generate a strong secret for production!
JWT_SECRET=change_this_to_a_strong_secret_key_for_production
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:5173

# ===========================
# WORKER CONFIGURATION
# ===========================
# The worker reads MONGO_URI and REDIS_HOST from environment
# Ensure same values as backend for consistency

# ===========================
# FRONTEND CONFIGURATION
# ===========================
# API URL for client-side requests
# Use localhost for browser access, service name for internal container access
VITE_API_URL=http://localhost:5000/api

# ===========================
# OPTIONAL CONFIGURATIONS
# ===========================
LOG_LEVEL=info
DEBUG=false
